{
  "name": "dsh-helper",
  "version": "0.1.0",
  "description": "DSH task notifier & auto-retry plugin: pops Windows notifications when an agent session finishes, errors, or needs confirmation, and auto-retries transient request failures by a configured count.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "notifier",
    "notification",
    "windows",
    "toast",
    "retry",
    "auto-retry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunligh91/dsh-helper.git"
  },
  "homepage": "https://github.com/sunligh91/dsh-helper#readme",
  "bugs": {
    "url": "https://github.com/sunligh91/dsh-helper/issues"
  },
  "peerDependencies": {
    "cordis": "*",
    "react": "*"
  },
  "dependencies": {
    "dsh-shared": "^0.1.0"
  },
  "license": "MIT"
}
